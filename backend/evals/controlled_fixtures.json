      "refund": [["id", "amount"], [1, 30]],
      "status": [["kind", "id", "seq", "state"], ["p", 1, 1, "NEW"], ["p", 1, 2, "OK"], ["p", 2, 1, "NEW"], ["p", 2, 2, "OK"], ["r", 1, 1, "NEW"], ["r", 1, 2, "OK"]]
    },
    "reference_sql": "WITH ranked AS (SELECT *, ROW_NUMBER() OVER(PARTITION BY kind,id ORDER BY seq DESC) rn FROM status), g AS (SELECT (SELECT SUM(amount) FROM orders) sales,(SELECT SUM(amount) FROM split JOIN ranked ON id=payment AND kind='p' AND rn=1 AND state='OK') pay,(SELECT SUM(amount) FROM refund r JOIN ranked s ON s.id=r.id AND kind='r' AND rn=1 AND state='OK') refunded) SELECT sales,pay,refunded,pay-refunded FROM g",
    "expected_rows": [[250, 200, 30, 170]]
  },
